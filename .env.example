# Neon Console -> Project -> Connect -> Connection string (pooling ON)
# Do NOT commit this file after copying to .env
DATABASE_URL=postgresql://YOUR_ROLE:YOUR_PASSWORD@YOUR-NEON-HOST-pooler.neon.tech/YOUR_DATABASE?sslmode=require

# Optional: Neon direct connection URL (pooling OFF), preferred for migrations
# DIRECT_URL=postgresql://YOUR_ROLE:YOUR_PASSWORD@YOUR-NEON-HOST.neon.tech/YOUR_DATABASE?sslmode=require

PORT=4000
